{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GardenOS crop catalogue v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "crops"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "crops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "family",
          "lifecycle",
          "region",
          "cultivation",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "enum": [
              "vegetable",
              "fruit",
              "herb"
            ]
          },
          "family": {
            "type": "string"
          },
          "lifecycle": {
            "enum": [
              "annual",
              "perennial"
            ]
          },
          "region": {
            "type": "string"
          },
          "cultivation": {
            "type": "object",
            "required": [
              "method",
              "sowMonths",
              "harvestMonths",
              "spacingCm",
              "rowSpacingCm",
              "light",
              "soil",
              "yield",
              "occupancy"
            ],
            "properties": {
              "method": {
                "type": "string"
              },
              "protected": {
                "type": "boolean"
              },
              "sowMonths": {
                "$ref": "#/$defs/monthWindow"
              },
              "harvestMonths": {
                "$ref": "#/$defs/monthWindow"
              },
              "sowWindowWraps": {
                "type": "boolean"
              },
              "harvestWindowWraps": {
                "type": "boolean"
              },
              "spacingCm": {
                "$ref": "#/$defs/typical"
              },
              "rowSpacingCm": {
                "$ref": "#/$defs/typical"
              },
              "light": {
                "type": "object"
              },
              "soil": {
                "type": "object"
              },
              "yield": {
                "type": "object"
              },
              "occupancy": {
                "type": "object"
              },
              "support": {
                "type": "string"
              }
            }
          },
          "provenance": {
            "type": "object",
            "required": [
              "status",
              "region",
              "reviewed"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "monthWindow": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "typical": {
      "type": "object",
      "required": [
        "typical"
      ],
      "properties": {
        "typical": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}